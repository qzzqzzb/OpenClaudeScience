{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; /usr/bin/env python3 \"$ROOT/.codex/hooks/superme_stop.py\"",
            "statusMessage": "Checking SuperMe workflow state",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
