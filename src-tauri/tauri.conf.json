{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaudeScience",
  "version": "0.1.0",
  "identifier": "com.openclaudescience.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaudeScience",
        "width": 1480,
        "height": 930,
        "minWidth": 1120,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
