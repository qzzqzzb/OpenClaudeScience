{
  "name": "open-claude-science",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/adapter/server.ts",
    "dev:adapter": "tsx src/adapter/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:managed": "set ADAPTER_RUNTIME_MODE=managed&& tsx src/adapter/server.ts",
    "build": "npm run build:adapter && npm run build:web",
    "build:adapter": "tsc -p tsconfig.json",
    "build:web": "tsc -p tsconfig.web.json && vite build",
    "start": "node dist/adapter/server.js",
    "start:managed": "set ADAPTER_RUNTIME_MODE=managed&& node dist/adapter/server.js",
    "check": "npm run check:adapter && npm run check:web",
    "check:adapter": "tsc -p tsconfig.json --noEmit",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fastify/websocket": "11.2.0",
    "@opencode-ai/sdk": "1.17.12",
    "@tauri-apps/api": "^2.9.0",
    "fastify": "5.6.2",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "nanoid": "5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@tauri-apps/cli": "^2.9.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "^6.0.7",
    "vitest": "4.0.15"
  }
}
